{
  "version": "v1",
  "purpose": "Node profile field contract for new-node Top3 business recommendation and existing-node business correction.",
  "source_artifacts": {
    "node_profile": "multibusiness_nodes.csv",
    "business_outcomes": "multibusiness_outcomes.csv",
    "business_recommendations": "multibusiness_recommendations.csv",
    "wide_table_schema": "node_day_ops_wide_full_schema_summary.md"
  },
  "decision_policy": {
    "node_assignment_mode": "single_business",
    "recommendation_output": "top3_with_reason_and_risk",
    "objective": "average_miner_and_operator",
    "objective_formula_v1": "combined_score = 0.5 * miner_score + 0.5 * operator_score",
    "hard_business_admission_rules": "none_known",
    "human_review_required": true
  },
  "groups": [
    {
      "name": "identity",
      "description": "Identifiers and snapshot dates. Used for joins, traceability, and display; not model signals except vendorid.",
      "fields": [
        {
          "field": "node_id",
          "label": "节点ID",
          "source": "multibusiness_nodes.csv",
          "upstream": "jarvis.node_analysis_data/node_join/dial_acc",
          "coverage": 1.0,
          "type": "categorical_id",
          "new_node_model": false,
          "existing_node_model": false,
          "display": true,
          "missing_policy": "required",
          "notes": "Primary join key; never train as a feature."
        },
        {
          "field": "online_day",
          "label": "上线日/业务首次日",
          "source": "multibusiness_nodes.csv",
          "upstream": "test.node_day_ops_wide_full",
          "coverage": 1.0,
          "type": "date",
          "new_node_model": false,
          "existing_node_model": false,
          "display": true,
          "missing_policy": "required",
          "notes": "Used for historical snapshot alignment."
        },
        {
          "field": "attribute_day",
          "label": "属性快照日",
          "source": "multibusiness_nodes.csv",
          "upstream": "derived",
          "coverage": 1.0,
          "type": "date",
          "new_node_model": false,
          "existing_node_model": false,
          "display": true,
          "missing_policy": "required",
          "notes": "Current historical model uses online_day minus 1 day."
        },
        {
          "field": "attribute_snapshot_mode",
          "label": "属性快照口径",
          "source": "multibusiness_nodes.csv",
          "upstream": "derived",
          "coverage": 1.0,
          "type": "categorical",
          "new_node_model": false,
          "existing_node_model": false,
          "display": true,
          "missing_policy": "required",
          "notes": "Expected current value: online_day_minus_1d."
        },
        {
          "field": "vendorid",
          "label": "供应商/矿主ID",
          "source": "multibusiness_nodes.csv",
          "upstream": "jarvis.node_join",
          "coverage": 0.6882,
          "type": "categorical",
          "new_node_model": true,
          "existing_node_model": true,
          "display": true,
          "missing_policy": "unknown_category",
          "notes": "High-cardinality category; keep only if encoder can handle unknowns."
        }
      ]
    },
